{
  "$schema": "./config.schema.json",
  "_comment": "Copy this file to config.json and edit the copy. config.json is ignored by git.",

  "ExcludedModules": [],

  "PinnedModules": {},

  "LogRetentionDays": 180,

  "TrustPSGallery": true,

  "NotificationMode": "Always",

  "ModuleUpdateTimeoutSeconds": 600,

  "Healthchecks": {
    "Enabled": false,
    "SecretName": "PSModuleMaintenance-Healthchecks",
    "SecretVault": "SecretStore",
    "TimeoutSeconds": 10
  }
}
